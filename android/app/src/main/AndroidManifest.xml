<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />

    <!--
      A receipt can be captured with the camera, but through the system camera app: the picture is
      taken in that app and written to a URI this one supplies. Declaring CAMERA would only add a
      runtime-permission prompt to a flow that needs none, so the feature stays optional hardware
      and the app never asks for the permission.
    -->
    <uses-feature
        android:name="android.hardware.camera"
        android:required="false" />

    <application
        android:allowBackup="false"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Rentivo">

        <activity
            android:name=".app.MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.Rentivo"
            android:windowSoftInputMode="adjustResize">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
          The only bridge between this app's private cache and another app, in both directions:
          read access to a single downloaded file handed to the share sheet, and write access to a
          single capture destination handed to the camera app. Both live in the cache, so a
          content:// URI plus a one-shot grant is the only way another app can touch one; the two
          directories exposed are listed in @xml/file_paths.
        -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>

</manifest>
