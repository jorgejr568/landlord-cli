<?xml version="1.0" encoding="utf-8"?>
<!--
  The only two paths the app ever shares, both subdirectories of the private cache: the downloads
  DownloadedFileStore owns, handed to the share sheet, and the captures ReceiptCaptureStore owns,
  handed to the camera app so it can write a receipt photo. Nothing else in the cache — or anywhere
  else on disk — is exposed.
-->
<paths>
    <cache-path
        name="downloads"
        path="RentivoDownloads/" />
    <cache-path
        name="captures"
        path="RentivoCaptures/" />
</paths>
